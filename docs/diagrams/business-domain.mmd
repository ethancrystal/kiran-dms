flowchart TB
    subgraph EXTERNAL["People and organisations"]
      OWNER["Owner"]
      MANAGER["Manager"]
      REP["Salaried Sales Rep"]
      AGENT["Independent Agent"]
      INVESTOR["Investor / Capital Partner"]
      SALON["Salon / Customer"]
      SUPPLIER["Supplier"]
    end

    subgraph SURFACES["Kiran DMS access surfaces"]
      OFFICE["Office / Admin Console\nOwner governance + manager operations"]
      REPAPP["Rep PWA\nTerritories, routes, bag, visits, orders, collections"]
      AGENTAPP["Agent Workspace\nOwn catalogue, availability, paid purchases"]
      INVESTORAPP["Proposed Investor Workspace\nOwn contributions, batch allocations, statements"]
      SALON_TOUCH["Customer-facing documents\nInvoices, receipts, statements, reminders"]
      VAULTUI["Restricted Procurement / Vault UI\nAuthorised internal Kiran users only"]
    end

    subgraph CORE["Shared business operating platform"]
      IAM["Identity, roles, permissions, MFA, devices"]
      CRM["Salon CRM and pipeline"]
      CATALOG["Product, SKU and selling-price catalogue"]
      PROCUREMENT["Supplier records, purchase orders, goods receipts"]
      INVENTORY["Warehouse stock, batches and stock movements"]
      SALON_SALES["Salon orders, deliveries, invoices, payments, receivables"]
      AGENT_SALES["Agent cash-and-carry sales"]
      CAPITAL["Investor capital ledger\nContributions and batch allocations"]
      SETTLEMENT["Batch accounting and settlement\nContract-governed; not a guaranteed return"]
      CONTROL["Approvals, audit, reconciliation and reporting"]
      VAULT["Restricted supplier and cost compartment"]
    end

    OWNER --> OFFICE
    MANAGER --> OFFICE
    REP --> REPAPP
    AGENT --> AGENTAPP
    INVESTOR --> INVESTORAPP
    SALON --> SALON_TOUCH
    SUPPLIER -. "Goods and documents delivered to authorised staff; no supplier login assumed" .-> VAULTUI

    OFFICE --> IAM
    OFFICE --> CONTROL
    OFFICE --> CRM
    OFFICE --> CATALOG
    OFFICE --> INVENTORY
    REPAPP --> CRM
    REPAPP --> SALON_SALES
    AGENTAPP --> AGENT_SALES
    INVESTORAPP --> CAPITAL
    INVESTORAPP --> SETTLEMENT
    SALON_TOUCH --> SALON_SALES
    VAULTUI --> PROCUREMENT
    VAULTUI --> VAULT

    PROCUREMENT --> INVENTORY
    CATALOG --> SALON_SALES
    CATALOG --> AGENT_SALES
    INVENTORY --> SALON_SALES
    INVENTORY --> AGENT_SALES
    CRM --> SALON_SALES

    SALON_SALES --> CONTROL
    AGENT_SALES --> CONTROL
    CAPITAL --> SETTLEMENT
    SALON_SALES --> SETTLEMENT
    INVENTORY --> SETTLEMENT
    VAULT -. "restricted cost data only through approved vault logic" .-> SETTLEMENT

    PROCUREMENT -. "opaque receipt bridge: SKU, quantity, internal batch reference only" .-> INVENTORY
    SETTLEMENT --> CONTROL
    CONTROL --> OFFICE
