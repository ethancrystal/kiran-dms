---------------------------- MODULE ApprovalLifecycle ----------------------------
(***************************************************************************)
(* Kiran DMS: approval lifecycle as proposed in RFC issue #4               *)
(* (request -> decide -> authorize, single use).                           *)
(*                                                                         *)
(* Each RPC is one atomic step. The real functions get that atomicity      *)
(* from SECURITY DEFINER transactions, FOR UPDATE row locks and unique     *)
(* indexes. Users, requests, subjects and consumers are model values.     *)
(* Money is an abstract amount 1..MaxAmount. The doc 13 section 9 matrix   *)
(* is reduced to three representative kinds:                              *)
(*   discount         - manager checks, owner above the threshold          *)
(*   write_off        - always the owner (coded floor)                     *)
(*   credit_override  - no checker below the cap, owner above              *)
(*                                                                         *)
(* The three boolean constants switch individual checks off. Each mutant   *)
(* config sets one of them to FALSE and expects TLC to find a              *)
(* counterexample, which shows the matching invariant is not vacuous.      *)
(***************************************************************************)
EXTENDS Naturals, FiniteSets, TLC

CONSTANTS
    Reps, Managers, Owners,   \* users by role (disjoint sets of model values)
    Requests,                 \* request client_ids (generated by the maker, offline)
    Subjects,                 \* orders, payments, salons ...
    Consumers,                \* rows a gated domain action creates or changes
    MaxAmount,                \* server-computed facts range over 1..MaxAmount
    Thresholds,               \* values the owner may give the approval.* config keys
    None,                     \* model value: no user / no approval
    RecheckAtUse,             \* RFC: route recomputed from current config at use
    CheckCoverage,            \* RFC: server facts must be covered by the approved payload
    EnforceSingleUse          \* RFC: unique (approval_id) on authorized_action

ASSUME /\ Reps \cap Managers = {} /\ Reps \cap Owners = {} /\ Managers \cap Owners = {}
       /\ Owners # {}
       /\ MaxAmount \in Nat \ {0}
       /\ Thresholds \subseteq 1..MaxAmount /\ Thresholds # {}
       /\ RecheckAtUse \in BOOLEAN /\ CheckCoverage \in BOOLEAN /\ EnforceSingleUse \in BOOLEAN

Users    == Reps \cup Managers \cup Owners
Office   == Managers \cup Owners
Kinds    == {"discount", "write_off", "credit_override"}
Amounts  == 1..MaxAmount
Levels   == {"none", "manager", "owner"}
Statuses == {"absent", "pending", "approved", "rejected", "cancelled"}
Decided  == {"approved", "rejected", "cancelled"}

Rank(l)     == CASE l = "none" -> 0 [] l = "manager" -> 1 [] l = "owner" -> 2
RoleRank(u) == IF u \in Owners THEN 2 ELSE IF u \in Managers THEN 1 ELSE 0
Stricter(a, b) == IF Rank(a) >= Rank(b) THEN a ELSE b

(* Coded floor plus owner-configured threshold: the strictest applies.     *)
Route(k, amt, t) ==
    CASE k = "write_off"       -> "owner"
      [] k = "credit_override" -> IF amt > t THEN "owner" ELSE "none"
      [] k = "discount"        -> IF amt > t THEN "owner" ELSE "manager"

(* Reps may only request discounts here (the real list also has          *)
(* return_accept and payment_reversal, which are not modelled).           *)
MayMake(u, k)    == IF u \in Reps THEN k = "discount" ELSE TRUE
CanCheck(u, lvl) == u \in Office /\ RoleRank(u) >= Rank(lvl)

Absent == [status |-> "absent", kind |-> None, subject |-> None, amount |-> 0,
           maker |-> None, checker |-> None, level |-> "none"]

ReqRec == [status : Statuses, kind : Kinds \cup {None}, subject : Subjects \cup {None},
           amount : Amounts \cup {0}, maker : Users \cup {None},
           checker : Users \cup {None}, level : Levels]

(* One row of control.authorized_action. checkerActive is ghost state   *)
(* that is only used to state open question 5.                         *)
UseRec == [approval : Requests \cup {None}, consumer : Consumers, kind : Kinds,
           subject : Subjects, amount : Amounts, route : Levels, actor : Users,
           checkerActive : BOOLEAN]

VARIABLES
    req,        \* control.approval_request, by client_id
    uses,       \* control.authorized_action (append-only)
    threshold,  \* current app_config approval.* value
    active      \* user_profile.status = 'active'

vars == <<req, uses, threshold, active>>

TypeOK ==
    /\ req \in [Requests -> ReqRec]
    /\ uses \subseteq UseRec
    /\ threshold \in Thresholds
    /\ active \in [Users -> BOOLEAN]

Init ==
    /\ req = [r \in Requests |-> Absent]
    /\ uses = {}
    /\ threshold \in Thresholds
    /\ active = [u \in Users |-> TRUE]

(* app.request_approval. The level is computed on the server; the caller *)
(* cannot choose it. A replay of the same client_id is a no-op, and one  *)
(* with different content is refused (23505); both are covered by the    *)
(* status = "absent" guard. The amount is what the maker claims.         *)
Request(u, r, k, s, a) ==
    /\ active[u]
    /\ MayMake(u, k)
    /\ req[r].status = "absent"
    /\ Route(k, a, threshold) # "none"
    /\ req' = [req EXCEPT ![r] = [status |-> "pending", kind |-> k, subject |-> s,
                                  amount |-> a, maker |-> u, checker |-> None,
                                  level |-> Route(k, a, threshold)]]
    /\ UNCHANGED <<uses, threshold, active>>

CurrentLevel(r) == Stricter(req[r].level, Route(req[r].kind, req[r].amount, threshold))

(* decide_approval recomputes the route. If the result is stricter, the   *)
(* level rises and the request stays pending.                            *)
Escalate(r) ==
    /\ req[r].status = "pending"
    /\ CurrentLevel(r) # req[r].level
    /\ req' = [req EXCEPT ![r].level = CurrentLevel(r)]
    /\ UNCHANGED <<uses, threshold, active>>

(* app.decide_approval *)
Decide(u, r, approve) ==
    /\ active[u]
    /\ req[r].status = "pending"
    /\ CurrentLevel(r) = req[r].level
    /\ u # req[r].maker
    /\ CanCheck(u, req[r].level)
    /\ req' = [req EXCEPT ![r].status  = IF approve THEN "approved" ELSE "rejected",
                          ![r].checker = u]
    /\ UNCHANGED <<uses, threshold, active>>

(* app.cancel_approval: only the maker, only while pending *)
Cancel(u, r) ==
    /\ active[u]
    /\ req[r].status = "pending"
    /\ req[r].maker = u
    /\ req' = [req EXCEPT ![r].status = "cancelled"]
    /\ UNCHANGED <<uses, threshold, active>>

ApprovalOK(u, r, k, s, a) ==
    LET rt == Route(k, a, threshold) IN
    /\ req[r].status = "approved"
    /\ req[r].kind = k
    /\ req[r].subject = s
    /\ CheckCoverage => a <= req[r].amount
    /\ IF RecheckAtUse THEN RoleRank(req[r].checker) >= Rank(rt)
                       ELSE RoleRank(req[r].checker) >= Rank(req[r].level)
    /\ EnforceSingleUse => \A x \in uses : x.approval # r
    /\ u = req[r].maker \/ u \in Office          \* open question 3: model is permissive

(* app.authorize_action, called inside a domain function. The amount a is   *)
(* the server-computed fact, which may differ from what the maker claimed. *)
(* A replay by the same consumer returns the existing row, so it is a      *)
(* stutter step here.                                                     *)
Authorize(u, c, k, s, a, r) ==
    LET rt == Route(k, a, threshold) IN
    /\ active[u]
    /\ ~\E x \in uses : x.kind = k /\ x.consumer = c
    /\ IF rt = "none" THEN r = None
                      ELSE r \in Requests /\ ApprovalOK(u, r, k, s, a)
    /\ uses' = uses \cup
         {[approval |-> r, consumer |-> c, kind |-> k, subject |-> s, amount |-> a,
           route |-> rt, actor |-> u,
           checkerActive |-> IF r = None THEN TRUE ELSE active[req[r].checker]]}
    /\ UNCHANGED <<req, threshold, active>>

(* app.owner_set_config on an approval.* key. Values stay inside the     *)
(* fixed set Thresholds; changing the real values needs MJ (H-26).       *)
ChangeThreshold(t) ==
    /\ t # threshold
    /\ threshold' = t
    /\ UNCHANGED <<req, uses, active>>

(* owner_set_status: suspend or offboard a non-owner *)
Offboard(u) ==
    /\ u \notin Owners
    /\ active[u]
    /\ active' = [active EXCEPT ![u] = FALSE]
    /\ UNCHANGED <<req, uses, threshold>>

Next ==
    \/ \E u \in Users, r \in Requests, k \in Kinds, s \in Subjects, a \in Amounts :
           Request(u, r, k, s, a)
    \/ \E r \in Requests : Escalate(r)
    \/ \E u \in Users, r \in Requests, b \in BOOLEAN : Decide(u, r, b)
    \/ \E u \in Users, r \in Requests : Cancel(u, r)
    \/ \E u \in Users, c \in Consumers, k \in Kinds, s \in Subjects, a \in Amounts,
          r \in Requests \cup {None} : Authorize(u, c, k, s, a, r)
    \/ \E t \in Thresholds : ChangeThreshold(t)
    \/ \E u \in Users : Offboard(u)

(* Safety only: approvals may queue forever by design (doc 13 section 1), *)
(* so no fairness is assumed.                                            *)
Spec == Init /\ [][Next]_vars

---------------------------------------------------------------------------
(* State invariants *)

S1_MakerNeChecker ==                                    \* SEC-11, H-12
    \A r \in Requests : req[r].checker # None => req[r].checker # req[r].maker

S2_SingleUse ==                                         \* RFC: unique (approval_id)
    \A x, y \in uses : (x.approval # None /\ x.approval = y.approval) => x = y

S3_GatedActionCovered ==                                \* approved, same kind/subject, covered
    \A x \in uses : x.route # "none" =>
        /\ x.approval \in Requests
        /\ req[x.approval].status = "approved"
        /\ req[x.approval].kind = x.kind
        /\ req[x.approval].subject = x.subject
        /\ x.amount <= req[x.approval].amount

S4_CheckerLevelAtUse ==                                 \* checker's role >= route at use time
    \A x \in uses : x.approval # None =>
        RoleRank(req[x.approval].checker) >= Rank(x.route)

S5_WriteOffOwnerChecked ==                              \* doc 13 section 9: always owner
    \A x \in uses : x.kind = "write_off" => req[x.approval].checker \in Owners

S6_OnlyOfficeChecks ==                                  \* reps never check
    \A r \in Requests : req[r].checker # None => req[r].checker \in Office

S7_OneActionPerConsumer ==                              \* unique (kind, consumer): idempotent replay
    \A x, y \in uses : (x.kind = y.kind /\ x.consumer = y.consumer) => x = y

S8_RepKinds ==                                          \* reps request only allowed kinds
    \A r \in Requests : req[r].maker \in Reps => req[r].kind = "discount"

S9_DecidedHasChecker ==                                 \* approval_decision_shape CHECK
    \A r \in Requests :
        /\ req[r].status \in {"approved", "rejected"} => req[r].checker # None
        /\ req[r].status \in {"absent", "pending", "cancelled"} => req[r].checker = None

(* Added by L-0192 after the independent review (L-0191): the decision-time *)
(* rank check in CanCheck is otherwise read by no property, because S4 and  *)
(* S5 only look at recorded uses. Both hold on the spec as written.         *)
S10_DeciderRankCoversLevel ==                           \* decider's role >= the level decided at
    \A r \in Requests : req[r].status \in {"approved", "rejected"} =>
        RoleRank(req[r].checker) >= Rank(req[r].level)

S13_WriteOffDecidedByOwner ==                           \* doc 13 section 9: write-offs are decided by an owner
    \A r \in Requests : (req[r].kind = "write_off" /\ req[r].checker # None) =>
        req[r].checker \in Owners

(* Open question 2: with a single owner account, an owner-made write-off  *)
(* can never be approved. Expected to HOLD when Cardinality(Owners) = 1.  *)
G1_OwnerWriteOffStuck ==
    Cardinality(Owners) = 1 =>
        \A r \in Requests :
            (req[r].kind = "write_off" /\ req[r].maker \in Owners) => req[r].status # "approved"

(* Open question 5: the RFC does NOT promise this. Expected to FAIL; the  *)
(* counterexample is a manager approving, being offboarded, and the      *)
(* approval being used afterwards.                                        *)
Q5_CheckerActiveAtUse == \A x \in uses : x.checkerActive

---------------------------------------------------------------------------
(* Action properties (checked as temporal PROPERTIES) *)

P1_DecidedImmutable ==                                  \* approval_guard; H-16
    [][\A r \in Requests : req[r].status \in Decided => req'[r] = req[r]]_vars

P2_UsesAppendOnly ==                                    \* H-06 style append-only
    [][uses \subseteq uses']_vars

P3_LevelOnlyRises ==                                    \* checker level only moves toward owner
    [][\A r \in Requests : Rank(req'[r].level) >= Rank(req[r].level)]_vars

---------------------------------------------------------------------------
(* State constraint for bounded checking. Two uses are enough for every  *)
(* counterexample listed in the mutant configs.                          *)
UsesBound == Cardinality(uses) <= 2

(* Symmetry: sound here because only safety properties are checked. *)
Symm == Permutations(Reps) \cup Permutations(Managers) \cup Permutations(Requests)
        \cup Permutations(Subjects) \cup Permutations(Consumers)

(* For configs with more than one owner (L-0192). Sound because nothing in this module tells one *)
(* owner from another: every formula quantifies over Owners uniformly, and there is no CHOOSE or  *)
(* ordering of model values. With one owner it is the identity, so one-owner results are unchanged. *)
SymmAll == Symm \cup Permutations(Owners)

=============================================================================
