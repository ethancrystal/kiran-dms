# Kiran DMS — example environment file for Railway.
#
# Copy to `.env.example` locally (git-ignored), then set the REAL values in
# Railway project → Variables (never commit secrets). Structure follows
# apps/web/lib/env.ts, which consumes only NEXT_PUBLIC_* + DATABASE_URL.
#
# Surface map (from the operator's env dump):
#   Field App   (rep PWA /app)  -> Supabase `rcwoiwtcjyikqvtdjulq`
#   Office      (/office)       -> Supabase `ffccrpejbkmmjgtekaql`
#   Shop/Portal -> Supabase `nwxidylbfeciungrqdkm`
#   Unified     -> Supabase `gurhodiindpufrdzxcdm`  (single bundled app)
#
# NEXT_PUBLIC_APP_SURFACE: "all" (unified single app) | "field" | "office" | "portal"
#
# Filled values live only in Railway (see docs/06-security-plan.md §8, H-18/H-20):
#   pnpm --filter @kiran/web start

# ---- Supabase (unified app) ----
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/postgres
SUPABASE_SECRET_KEY=<service role key>

# ---- Supabase (Field App, if separate) ----
NEXT_PUBLIC_FIELD_SUPABASE_URL=https://<field project>.supabase.co
NEXT_PUBLIC_FIELD_SUPABASE_ANON_KEY=<field anon key>

# ---- Supabase (Office Console, if separate) ----
NEXT_PUBLIC_OFFICE_SUPABASE_URL=https://<office project>.supabase.co
NEXT_PUBLIC_OFFICE_SUPABASE_ANON_KEY=<office anon key>

# ---- Railway custom domains / surface routing ----
NEXT_PUBLIC_FIELD_APP_URL=https://<field>.up.railway.app
NEXT_PUBLIC_OFFICE_CONSOLE_URL=https://<office>.up.railway.app
NEXT_PUBLIC_PORTAL_URL=https://<shop>.up.railway.app
NEXT_PUBLIC_APP_SURFACE=all
